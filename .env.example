# ----------------------------------------------------------------------------------------------------------
# Discord application (https://discord.com/developers/applications → your app)
# Bot tab → Reset Token / Copy. Enable BOTH privileged intents on that same tab:
#   • Server Members Intent   — member_list / member_info, and rank checks for everyone
#   • Message Content Intent  — reading a mention's text and the 👍/👎 feedback signals
# Then OAuth2 → URL Generator → scopes `bot` + `applications.commands` → invite it to your server.
# ----------------------------------------------------------------------------------------------------------
DISCORD_TOKEN=
# Application id (General Information → Application ID). `bun run setup` fills this in for you.
DISCORD_CLIENT_ID=
# Your own Discord user id. The owner skips every tier check and is the only one who can `/enable`.
# Discord → Settings → Advanced → Developer Mode → right-click yourself → Copy User ID.
OWNER_ID=
# Guild used for instant, guild-scoped command registration while developing (leave empty in production).
DISCORD_DEVELOPMENT_GUILD_ID=

# ----------------------------------------------------------------------------------------------------------
# Models
#
# Roles, not model names, are what the bot asks for:
#   MODEL_PRIMARY — chat, code, tool use (the expensive one)
#   MODEL_FAST    — reflection, memory extraction, consolidation (bulk text, cheap)
# Any `provider/model` the deployment has a provider for works; `/model set` overrides one guild and
# `MODEL_ALLOWLIST` pins the whole deployment to an exact list.
#
# Defaults run on the OpenCode Go subscription (the models the Go endpoint serves). One-time setup:
#   bun run auth        # stores the credential OpenCode Go accepts, in .data/console-token.json
# ----------------------------------------------------------------------------------------------------------
# MODEL_PRIMARY=opencode-go/crouton-alpha-free
# MODEL_FAST=opencode-go/beam-free
# Jev is called directly (not through opencode), so it is a bare model id.
# MODEL_JEV=jev-1.13-free
#
# Hard lockdown (optional): comma-separated allowlist. Unset = any model from a configured provider.
# MODEL_ALLOWLIST=opencode-go/crouton-alpha-free,opencode-go/beam-free

# --- alternative provider: OpenCode Go API key instead of `bun run auth` ----------------------------------
# OPENCODE_GO_API_KEY=

# --- alternative provider: OpenAI ---------------------------------------------------------
# MODEL_PRIMARY=openai/gpt-5.3-codex
# MODEL_FAST=openai/gpt-5-mini
# OPENAI_API_KEY=

# --- alternative provider: Anthropic ------------------------------------------------------
# MODEL_PRIMARY=anthropic/claude-sonnet-4-5
# MODEL_FAST=anthropic/claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- alternative provider: Google Gemini --------------------------------------------------
# MODEL_PRIMARY=google/gemini-2.5-pro
# MODEL_FAST=google/gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- alternative provider: OpenRouter (one key, many models) ------------------------------
# MODEL_PRIMARY=openrouter/anthropic/claude-sonnet-4.5
# MODEL_FAST=openrouter/google/gemini-2.5-flash
# OPENROUTER_API_KEY=

# --- other catalogue providers: deepseek, groq, xai, mistral, cerebras, togetherai ---------
# DEEPSEEK_API_KEY=   GROQ_API_KEY=   XAI_API_KEY=   MISTRAL_API_KEY=   CEREBRAS_API_KEY=   TOGETHER_API_KEY=
#
# Local runtimes and private gateways (Ollama, vLLM, LM Studio, LiteLLM, ...) are not in the catalogue: declare
# them in config/providers.json — copy config/providers.example.json and see the README. Their keys are named
# there (`apiKeyEnv`) and referenced as `{env:NAME}`, so no secret is ever written into a workspace.

# ----------------------------------------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Register slash commands on boot (default: true in development, false in production).
# AUTO_REGISTER_COMMANDS=true
# Loopback port the agent's Discord tools call back on. One bridge serves every guild.
BRIDGE_PORT=7071
# A turn is abandoned after this many ms *without any event* (deltas and tool parts reset it), so a long task
# that keeps working is never killed. Raise it for a slow local runtime. Default 600000 (10 min).
# IDLE_TIMEOUT_MS=600000
# Safety gate for tool calls: off | shadow (log Jev's reading, tier table decides) | enforce
JEV_MODE=shadow
# Optional overrides: the pinned binary (default: node_modules/opencode-ai) and the global CLI `bun run auth`
# probes (default: whatever `opencode` resolves to on PATH).
# OPENCODE_BIN=
# OPENCODE_CLI=
# Optional: point the provider registry somewhere other than config/providers.json.
# PROVIDERS_FILE=
# Optional: provide the Jev credential directly instead of probing `opencode auth export`.
# OPENCODE_CONSOLE_TOKEN=
