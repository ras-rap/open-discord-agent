# Discord application (dev portal → Bot → token; enable Guild Members + Message Content intents)
DISCORD_TOKEN=
BOT_CLIENT_ID=
# Your Discord user id: bypasses tier checks, can run /enable
OWNER_ID=

# Optional
BRIDGE_PORT=7071
LOG_LEVEL=info
# off | shadow (default) | enforce
JEV_MODE=shadow
# Override the pinned opencode binary path
# OPENCODE_BIN=/opt/open-discord-agent/node_modules/opencode-ai/bin/opencode.exe
# Global CLI used by `bun run auth` (defaults to the non-project `opencode` on PATH)
# OPENCODE_CLI=/usr/local/bin/opencode
# Register commands scoped to one guild so they appear instantly (global ones can lag up to an hour)
# REGISTER_GUILD_ID=123456789012345678
