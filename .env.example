# Discord application (Dev Portal -> Bot -> token). Enable Guild Members + Message Content intents.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild used for instant, guild-scoped command registration in development
DISCORD_DEVELOPMENT_GUILD_ID=
# Your Discord user id: bypasses tier checks and owns /enable
OWNER_ID=

# Environment
NODE_ENV=development
LOG_LEVEL=info
# Auto-register slash commands on boot (default true in development, false in production)
# AUTO_REGISTER_COMMANDS=true

# Agent
BRIDGE_PORT=7071
# off | shadow (default) | enforce
JEV_MODE=shadow
# Override the pinned opencode binary / the global CLI used by `bun run auth`
# OPENCODE_BIN=
# OPENCODE_CLI=
# Optional: provide the Jev credential directly instead of probing `opencode auth export`
# OPENCODE_CONSOLE_TOKEN=
